# GBNF grammar generated from training/schema.py (FraudSynthesized.model_json_schema()).
# Do not edit by hand: regenerate with `python generate_gbnf.py`.
# Start symbol: root
ws ::= | " " | "\n" [ \t]{0,20}
boolean ::= ("true" | "false") ws
string ::= "\"" ( [^"\\\x7F\x00-\x1F] | "\\" (["\\bfnrt"] | "u" [0-9a-fA-F]{4}) )* "\"" ws
enumSourceType ::= ("\"STREAM_ASR\"" | "\"WHATSAPP_DIRECT\"" | "\"WHATSAPP_GROUP\"" | "\"SMS\"" | "\"EMAIL\"") ws
enumRiskLevel ::= ("\"LOW\"" | "\"MEDIUM\"" | "\"HIGH\"" | "\"CRITICAL\"") ws
enumScamType ::= ("\"None\"" | "\"Falso Familiar / Extorsión Policial\"" | "\"Phishing / Suplantación Bancaria\"" | "\"Suplantación Entidad Pública (Aduana / Impuestos)\"" | "\"Fraude de Telecomunicaciones / Falso Soporte\"") ws
object ::= "{" ws "\"source_type\"" ws ":" ws enumSourceType "," ws "\"simulated_raw_text\"" ws ":" ws string "," ws "\"rationale\"" ws ":" ws string "," ws "\"is_scam\"" ws ":" ws boolean "," ws "\"risk_level\"" ws ":" ws enumRiskLevel "," ws "\"scam_type\"" ws ":" ws enumScamType ws "}"
root ::= object
